<%- include('partials/header') %>

<main id="main-content" class="auth-page">
  <div class="shell auth-grid">
    <section class="auth-panel">
      <p class="eyebrow">Password reset</p>
      <h1>This link no longer works</h1>
      <p class="muted">A reset link works once, for <%= minutes %> minutes, and only the newest link you asked for. This one has expired, was already used, or was replaced by a newer email.</p>

      <div class="auth-actions">
        <a class="button button-primary" href="/forgot-password"><%- icon('mail') %>Send a new link</a>
        <a class="text-link" href="<%= currentUser ? '/account' : '/login' %>"><%= currentUser ? 'Back to your account' : 'Back to log in' %></a>
      </div>
      <p class="auth-switch">Your password has not been changed.</p>
    </section>

    <%- include('partials/auth-art') %>
  </div>
</main>

<%- include('partials/footer') %>
