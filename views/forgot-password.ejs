<%- include('partials/header') %>

<main id="main-content" class="auth-page">
  <div class="shell auth-grid">
    <section class="auth-panel">
      <p class="eyebrow">Password reset</p>
      <h1>Forgot your password?</h1>
      <p class="muted">Enter the email address of your account and we will send you a link to choose a new password.</p>

      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert">
          <% errors.forEach((error) => { %>
            <p><%= error %></p>
          <% }) %>
        </div>
      <% } %>

      <form action="/forgot-password" method="post" class="auth-form stack-form">
        <div class="field">
          <label for="email">Email address</label>
          <div class="input-with-icon">
            <%- icon('mail') %>
            <input id="email" name="email" type="email" value="<%= email %>" autocomplete="email" maxlength="<%= emailMaxLength %>" placeholder="name@example.com" required autofocus>
          </div>
        </div>

        <button class="button button-primary button-lg button-block" type="submit">Send reset link<%- icon('arrow-right') %></button>
        <p class="form-agreement"><%- icon('lock', 'icon-sm') %>The link works once, for <%= minutes %> minutes. Your password stays the same until you use it.</p>
      </form>

      <% if (currentUser) { %>
        <p class="auth-switch">Remembered it? <a class="text-link" href="/account#password">Back to your account</a></p>
      <% } else { %>
        <p class="auth-switch">Remembered it? <a class="text-link" href="/login">Back to log in</a></p>
      <% } %>
    </section>

    <%- include('partials/auth-art') %>
  </div>
</main>

<%- include('partials/footer') %>
