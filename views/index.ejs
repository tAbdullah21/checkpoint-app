<%- include('partials/header') %>

<main id="main-content" class="home">
  <% if (currentUser) { %>
    <%# ===== Member dashboard ===== %>
    <section class="shell dash">
      <div class="dash-greeting animate-rise">
        <div>
          <p class="eyebrow"><span class="online-dot" aria-hidden="true"></span>Welcome back, <%= currentUser.name.split(' ')[0] %></p>
          <h1>Ready for your next <span class="gradient-text">checkpoint</span>?</h1>
        </div>
        <div class="dash-greeting-actions">
          <% if (dashboard.pickerCandidates.length > 1) { %>
            <button class="button button-ai" type="button" data-picker-open><%- icon('dice') %>Pick my next game</button>
          <% } %>
          <a class="button button-secondary" href="/library"><%- icon('columns') %>Library board</a>
        </div>
      </div>

      <div class="dash-grid">
        <% if (forYou && !forYou.isColdStart && forYou.picks.length > 0) { %>
          <% const top = forYou.picks[0]; %>
          <article class="spotlight animate-rise" style="--delay: 80ms">
            <img class="spotlight-backdrop" src="<%= thumb(top.game.image, 'small') %>" alt="" aria-hidden="true">
            <div class="spotlight-inner">
              <a class="spotlight-poster" href="/games/<%= top.slug %>" data-poster-link>
                <img <%- coverAttributes(top.game.image, '(max-width: 560px) 40vw, 260px') %> alt="<%= top.game.title %> cover" width="600" height="900" fetchpriority="high">
              </a>
              <div class="spotlight-copy">
                <p class="eyebrow eyebrow-plain"><%- icon('crown', 'icon-sm') %>Your #1 pick today <span class="ai-tag">AI</span></p>
                <h2><a href="/games/<%= top.slug %>"><%= top.game.title %></a></h2>
                <p class="spotlight-meta"><%= top.game.year %> · <%= top.game.genre %> · <span class="stars">★</span> <%= Number(top.game.rating).toFixed(1) %></p>
                <p class="spotlight-reason"><%- icon('sparkles', 'icon-sm') %><%= top.reason %></p>
                <% if (top.traits.length) { %>
                  <div class="chip-list"><% top.traits.forEach((trait) => { %><span class="chip"><%= trait %></span><% }) %></div>
                <% } %>
                <div class="spotlight-actions">
                  <form action="/library/<%= top.slug %>/add" method="post" data-quick-add>
                    <input type="hidden" name="status" value="want_to_play">
                    <input type="hidden" name="returnTo" value="/">
                    <button class="button button-primary" type="submit"><%- icon('plus') %>Want to Play</button>
                  </form>
                  <a class="button button-glass" href="/games/<%= top.slug %>">View game</a>
                </div>
              </div>
              <div class="spotlight-match">
                <div class="match-ring match-ring-lg" style="--match: <%= top.match %>"><strong><%= top.match %>%</strong></div>
                <span>match</span>
              </div>
            </div>
          </article>
        <% } else { %>
          <article class="spotlight spotlight-onboarding animate-rise" style="--delay: 80ms">
            <div class="onboarding-copy">
              <p class="eyebrow">Get started <span class="ai-tag">AI</span></p>
              <h2>Teach Checkpoint your taste</h2>
              <p>Three quick steps and your homepage turns into personal picks, each with a match percentage and a reason.</p>
            </div>
            <ol class="onboarding-steps">
              <li class="<%= dashboard.steps.library ? 'is-done' : '' %>">
                <span class="onboarding-check"><%- dashboard.steps.library ? icon('check') : '1' %></span>
                <div><strong>Save a game to your library</strong><small>Use the + on any cover.</small></div>
                <a class="link-arrow" href="/games">Browse<%- icon('arrow-right') %></a>
              </li>
              <li class="<%= dashboard.steps.rating ? 'is-done' : '' %>">
                <span class="onboarding-check"><%- dashboard.steps.rating ? icon('check') : '2' %></span>
                <div><strong>Rate a game you finished</strong><small>5★ pulls similar games up.</small></div>
                <a class="link-arrow" href="/games?sort=rating">Rate<%- icon('arrow-right') %></a>
              </li>
              <li class="<%= dashboard.steps.genres ? 'is-done' : '' %>">
                <span class="onboarding-check"><%- dashboard.steps.genres ? icon('check') : '3' %></span>
                <div><strong>Pick your favorite genres</strong><small>Up to five, in your profile.</small></div>
                <a class="link-arrow" href="/profile/edit">Choose<%- icon('arrow-right') %></a>
              </li>
            </ol>
          </article>
        <% } %>

        <aside class="dash-side animate-rise" style="--delay: 160ms" aria-label="Your progress">
          <section class="panel dash-queue">
            <div class="panel-head">
              <h2><%- icon('play', 'icon-sm') %>Continue playing</h2>
              <a class="link-arrow" href="/library">Board<%- icon('arrow-right') %></a>
            </div>
            <% if (dashboard.queue.length > 0) { %>
              <ul class="queue-list">
                <% dashboard.queue.forEach((game) => { %>
                  <% const queueStatus = statusMeta(game.status); %>
                  <li class="queue-item">
                    <a class="queue-cover" href="/games/<%= game.slug %>" tabindex="-1" aria-hidden="true"><img src="<%= thumb(game.image, 'small') %>" alt="" width="600" height="900" loading="lazy"></a>
                    <div>
                      <a class="queue-title" href="/games/<%= game.slug %>"><%= game.title %></a>
                      <span class="status-badge <%= queueStatus.className %>"><%= queueStatus.label %></span>
                    </div>
                    <a class="icon-button" href="/games/<%= game.slug %>" aria-label="Open <%= game.title %>"><%- icon('chevron-right') %></a>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="empty-inline queue-empty">
                <p>Nothing in progress yet. Add a game and mark it as Playing to see it here.</p>
                <a class="button button-secondary button-sm" href="/games">Find a game</a>
              </div>
            <% } %>
          </section>

          <div class="panel dash-stats">
            <dl class="dash-stat-row">
              <div><dt>Tracked</dt><dd data-count-up="<%= dashboard.counts.total %>"><%= dashboard.counts.total %></dd></div>
              <div><dt>Completed</dt><dd data-count-up="<%= dashboard.counts.completed %>"><%= dashboard.counts.completed %></dd></div>
              <div><dt>Reviews</dt><dd data-count-up="<%= dashboard.counts.reviews %>"><%= dashboard.counts.reviews %></dd></div>
            </dl>
            <div class="level-line">
              <span class="level-badge">Lv <%= dashboard.level.level %></span>
              <progress class="progress" max="100" value="<%= dashboard.level.progress %>" aria-label="Progress to level <%= dashboard.level.level + 1 %>"><%= dashboard.level.progress %>%</progress>
              <a class="link-arrow" href="/wrapped">Wrapped<%- icon('arrow-right') %></a>
            </div>
            <p class="level-caption"><strong><%= dashboard.level.title %></strong> · <%= dashboard.level.xp %> XP · <%= dashboard.level.toNext %> XP to level <%= dashboard.level.level + 1 %></p>
          </div>
        </aside>
      </div>
    </section>

    <%- include('partials/featured-reel', { reel, reelLabel: 'Featured games' }) %>
    <%- include('partials/live-ticker', { ticker }) %>

    <% if (forYou && !forYou.isColdStart && forYou.picks.length > 1) { %>
      <section class="shell home-section" id="for-you" data-reveal>
        <div class="section-head">
          <div>
            <p class="eyebrow">Picked for you <span class="ai-tag">AI</span></p>
            <h2>Your next favorite game</h2>
          </div>
          <div class="section-actions">
            <a class="link-arrow" href="/for-you">See all picks<%- icon('arrow-right') %></a>
            <div class="rail-controls" data-rail-controls="rail-picks">
              <button class="icon-button" type="button" data-rail-prev aria-label="Scroll picks left"><%- icon('chevron-left') %></button>
              <button class="icon-button" type="button" data-rail-next aria-label="Scroll picks right"><%- icon('chevron-right') %></button>
            </div>
          </div>
        </div>
        <div class="rail" id="rail-picks">
          <section class="rail-track" tabindex="0" aria-label="Picked for you" data-rail-track>
            <% forYou.picks.slice(1).forEach((pick) => { %>
              <%- include('partials/game-card', { game: pick.game, pickMatch: pick.match, cardReason: pick.reason, returnTo: '/' }) %>
            <% }) %>
          </section>
        </div>
      </section>
    <% } %>
  <% } else { %>
    <%# ===== Guest landing ===== %>
    <section class="landing-hero">
      <div class="poster-wall" aria-hidden="true">
        <div class="poster-wall-inner">
          <% wallColumns.forEach((column, columnIndex) => { %>
            <div class="poster-col <%= columnIndex % 2 ? 'is-down' : '' %>">
              <% [...column, ...column].forEach((image, imageIndex) => { %>
                <img <%- coverAttributes(image, '(max-width: 1000px) 130px, (max-width: 1460px) 13vw, 190px') %> alt="" width="600" height="900" decoding="async"<% if (columnIndex === 0 && imageIndex === 0) { %> fetchpriority="high"<% } %>>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="shell landing-inner">
        <div class="landing-copy">
          <p class="eyebrow animate-rise">The social game diary</p>
          <h1 class="animate-rise" style="--delay: 80ms">Every game you play deserves a <span class="gradient-text">checkpoint</span>.</h1>
          <p class="landing-lead animate-rise" style="--delay: 160ms">Keep track of the games you play: a board for your backlog, AI picks that explain themselves, and reviews and lists to share with players who like what you like.</p>
          <div class="landing-actions animate-rise" style="--delay: 240ms">
            <a class="button button-primary button-lg" href="/register">Create a free account<%- icon('arrow-right') %></a>
            <a class="button button-glass button-lg" href="/games"><%- icon('gamepad') %>Explore games</a>
          </div>
          <dl class="landing-stats animate-rise" style="--delay: 320ms">
            <div><dt>Games</dt><dd data-count-up="<%= stats.games %>"><%= stats.games %></dd></div>
            <div><dt>Members</dt><dd data-count-up="<%= stats.members %>"><%= stats.members %></dd></div>
            <div><dt>Reviews</dt><dd data-count-up="<%= stats.reviews %>"><%= stats.reviews %></dd></div>
            <div><dt>Games tracked</dt><dd data-count-up="<%= stats.tracked %>"><%= stats.tracked %></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <%- include('partials/featured-reel', { reel, reelLabel: 'Featured games' }) %>
    <%- include('partials/live-ticker', { ticker }) %>

    <div class="shell home-section features" data-reveal>
      <article class="feature-card" style="--tile-color: var(--status-playing)">
        <span class="feature-icon"><%- icon('columns', 'icon-lg') %></span>
        <h2>Your backlog, as a board</h2>
        <p>Track games across Want to Play, Playing, Played and Completed. Pick favorites for your profile.</p>
        <div class="feature-visual feature-board" aria-hidden="true">
          <span class="status-badge status-want">Want to Play</span>
          <span class="status-badge status-playing">Playing</span>
          <span class="status-badge status-completed">Completed</span>
        </div>
      </article>
      <article class="feature-card" style="--tile-color: var(--violet)">
        <span class="feature-icon feature-icon-ai"><%- icon('sparkles', 'icon-lg') %></span>
        <h2>Picks that explain themselves</h2>
        <p>A content-based recommender turns your ratings and library into a taste profile, then tells you why.</p>
        <div class="feature-visual" aria-hidden="true">
          <span class="match-chip">89% match</span>
          <span class="feature-reason">Because you rated Elden Ring 5★</span>
        </div>
      </article>
      <article class="feature-card" style="--tile-color: var(--pink)">
        <span class="feature-icon feature-icon-warm"><%- icon('users', 'icon-lg') %></span>
        <h2>Play it social</h2>
        <p>Follow players with a similar taste, vote on helpful reviews and build ranked lists worth sharing.</p>
        <div class="feature-visual" aria-hidden="true">
          <span class="avatar-stack">
            <% ['Lina', 'Omar', 'Noura', 'Faisal'].forEach((name) => { %><span class="avatar avatar-sm" style="--hue: <%= hueFor(name) %>"><%= name[0] %></span><% }) %>
          </span>
          <span class="feature-reason">+ taste match with every member</span>
        </div>
      </article>
    </div>

    <% if (pick && pick.slug) { %>
      <div class="shell home-section" data-reveal>
        <article class="spotlight spotlight-community">
          <img class="spotlight-backdrop" src="<%= thumb(pick.image, 'small') %>" alt="" aria-hidden="true">
          <div class="spotlight-inner">
            <a class="spotlight-poster" href="/games/<%= pick.slug %>" data-poster-link>
              <img <%- coverAttributes(pick.image, '(max-width: 560px) 40vw, 260px') %> alt="<%= pick.title %> cover" width="600" height="900" loading="lazy">
            </a>
            <div class="spotlight-copy">
              <p class="eyebrow eyebrow-plain"><%- icon('trophy', 'icon-sm') %><%= pick.label %></p>
              <h2><a href="/games/<%= pick.slug %>"><%= pick.title %></a></h2>
              <p class="spotlight-meta"><%= pick.year %> · <%= pick.genre %></p>
              <p class="spotlight-score"><span class="stars" role="img" aria-label="<%= Number(pick.rating).toFixed(1) %> out of 5 stars"><%- starString(pick.rating) %></span> <strong><%= Number(pick.rating).toFixed(1) %></strong> <small><%= pick.note %></small></p>
              <p class="spotlight-description"><%= pick.description %></p>
              <div class="spotlight-actions">
                <a class="button button-primary" href="/games/<%= pick.slug %>">View game<%- icon('arrow-right') %></a>
                <a class="button button-glass" href="/register">Rate it yourself</a>
              </div>
            </div>
          </div>
        </article>
      </div>
    <% } %>
  <% } %>

  <section class="shell home-section" id="trending" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Popular games</p>
        <h2>Big names, great reviews</h2>
      </div>
      <div class="section-actions">
        <a class="link-arrow" href="/games?sort=rating">Top rated<%- icon('arrow-right') %></a>
        <div class="rail-controls" data-rail-controls="rail-popular">
          <button class="icon-button" type="button" data-rail-prev aria-label="Scroll popular games left"><%- icon('chevron-left') %></button>
          <button class="icon-button" type="button" data-rail-next aria-label="Scroll popular games right"><%- icon('chevron-right') %></button>
        </div>
      </div>
    </div>
    <div class="rail" id="rail-popular">
      <section class="rail-track" tabindex="0" aria-label="Popular games" data-rail-track>
        <% popularGames.forEach((game) => { %>
          <%- include('partials/game-card', { game, returnTo: '/' }) %>
        <% }) %>
      </section>
    </div>
  </section>

  <section class="shell home-section" id="new-releases" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">New releases</p>
        <h2>Fresh checkpoints</h2>
      </div>
      <div class="section-actions">
        <a class="link-arrow" href="/games">Browse all games<%- icon('arrow-right') %></a>
        <div class="rail-controls" data-rail-controls="rail-new">
          <button class="icon-button" type="button" data-rail-prev aria-label="Scroll new releases left"><%- icon('chevron-left') %></button>
          <button class="icon-button" type="button" data-rail-next aria-label="Scroll new releases right"><%- icon('chevron-right') %></button>
        </div>
      </div>
    </div>
    <div class="rail" id="rail-new">
      <section class="rail-track" tabindex="0" aria-label="New releases" data-rail-track>
        <% newReleases.forEach((game) => { %>
          <%- include('partials/game-card', { game, returnTo: '/' }) %>
        <% }) %>
      </section>
    </div>
  </section>

  <div class="shell home-section community-split" data-reveal>
    <section class="panel" id="reviews">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Member reviews</p>
          <h2 class="panel-title">Recently reviewed</h2>
        </div>
      </div>
      <% if (recentReviews.length > 0) { %>
        <div class="review-stack">
          <% recentReviews.forEach((review) => { %>
            <article class="review-card">
              <a class="review-card-cover" href="/games/<%= review.slug %>" tabindex="-1" aria-hidden="true">
                <img src="<%= thumb(review.image, 'small') %>" alt="" width="600" height="900" loading="lazy">
              </a>
              <div>
                <div class="review-card-meta">
                  <span class="avatar avatar-xs" style="--hue: <%= hueFor(review.user_name) %>"><%= initial(review.user_name) %></span>
                  <% if (review.authorLinked) { %><a href="/members/<%= review.user_id %>"><strong><%= review.user_name %></strong></a><% } else { %><strong><%= review.user_name %></strong><% } %>
                  <span class="mini-stars" role="img" aria-label="<%= review.rating %> out of 5 stars"><%- starString(review.rating) %></span>
                  <time datetime="<%= isoTime(review.updated_at) %>"><%= review.displayDate %></time>
                </div>
                <h3><a href="/games/<%= review.slug %>"><%= review.title %></a></h3>
                <p class="review-text"><%= review.review_text || 'Rated without a written review.' %></p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="empty-state-icon"><%- icon('message') %></span>
          <h3>The review feed is ready</h3>
          <p>Open a game, publish the first member review, and it will appear here automatically.</p>
          <a class="button button-secondary button-sm" href="/games">Choose a game</a>
        </div>
      <% } %>
    </section>

    <aside class="panel" id="activity" aria-label="Community activity">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Live community</p>
          <h2 class="panel-title">Recent activity</h2>
        </div>
        <a class="link-arrow" href="/activity">See all<%- icon('arrow-right') %></a>
      </div>
      <% if (activity.length > 0) { %>
        <div class="feed">
          <% activity.forEach((item) => { %>
            <%- include('partials/activity-item', { item }) %>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-inline">No activity yet. Save a game or write a review and it will show up here.</p>
      <% } %>
    </aside>
  </div>

  <section class="shell home-section" id="lists" data-reveal>
    <div class="section-head">
      <div>
        <p class="eyebrow">Player lists</p>
        <h2>Lists worth saving</h2>
      </div>
      <a class="link-arrow" href="/lists">All lists<%- icon('arrow-right') %></a>
    </div>
    <% if (lists.length > 0) { %>
      <div class="card-grid card-grid-3">
        <% lists.forEach((list) => { %>
          <%- include('partials/list-card', { list }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <span class="empty-state-icon"><%- icon('list') %></span>
        <h3>No lists yet</h3>
        <p>Group games into a list like “Best co-op nights” and share it with other players.</p>
        <a class="button button-secondary" href="/lists/new">Create the first list</a>
      </div>
    <% } %>
  </section>

  <% if (!currentUser) { %>
    <div class="shell home-section" data-reveal>
      <div class="cta-band">
        <div class="cta-covers" aria-hidden="true">
          <% wallColumns.flat().slice(0, 8).forEach((image) => { %><img src="<%= thumb(image, 'small') %>" alt="" width="600" height="900" loading="lazy"><% }) %>
        </div>
        <div class="cta-copy">
          <p class="eyebrow">Checkpoint</p>
          <h2>Start your own game diary.</h2>
          <p>Create an account, save games, publish reviews, and get picks matched to your taste.</p>
        </div>
        <a class="button button-primary button-lg" href="/register">Join Checkpoint<%- icon('arrow-right') %></a>
      </div>
    </div>
  <% } %>
</main>

<% if (currentUser && dashboard.pickerCandidates.length > 1) { %>
  <%- include('partials/picker', { candidates: dashboard.pickerCandidates, pickerSource: dashboard.pickerSource }) %>
<% } %>

<%- include('partials/footer') %>
