<%- include('partials/header') %>

<main id="main-content" class="auth-page">
  <div class="shell auth-grid">
    <section class="auth-panel">
      <p class="eyebrow">Password reset</p>
      <h1>Check your email</h1>
      <p class="muted">If an account uses <strong class="auth-email"><%= email %></strong>, a link to choose a new password is on its way. It works once, for <%= minutes %> minutes.</p>

      <ol class="auth-steps">
        <li><span>1</span>Open the email “Reset your Checkpoint password”.</li>
        <li><span>2</span>Follow the link and choose a new password.</li>
        <li><span>3</span>Log in with the new password. Every device is signed out first.</li>
      </ol>

      <% if (mailboxEnabled) { %>
        <p class="dev-callout"><%- icon('info', 'icon-sm') %><span>Development mode sends no real email. Open the <a class="text-link" href="/dev/mailbox">development mailbox</a> on this computer to read it.</span></p>
      <% } %>

      <div class="auth-actions">
        <a class="button button-secondary" href="/forgot-password"><%- icon('mail') %>Send another link</a>
        <a class="text-link" href="<%= currentUser ? '/account' : '/login' %>"><%= currentUser ? 'Back to your account' : 'Back to log in' %></a>
      </div>
      <p class="auth-switch">No email after a few minutes? Check the spam folder and the spelling of the address.</p>
    </section>

    <%- include('partials/auth-art') %>
  </div>
</main>

<%- include('partials/footer') %>
