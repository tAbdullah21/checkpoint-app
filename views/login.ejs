<%- include('partials/header') %>

<main id="main-content" class="auth-page">
  <div class="shell auth-grid">
    <section class="auth-panel">
      <p class="eyebrow">Member login</p>
      <h1>Welcome back</h1>
      <p class="muted">Log in to continue building your game diary.</p>

      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert">
          <% errors.forEach((error) => { %>
            <p><%= error %></p>
          <% }) %>
        </div>
      <% } %>

      <form action="/login" method="post" class="auth-form stack-form">
        <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
        <div class="field">
          <label for="email">Email address</label>
          <div class="input-with-icon">
            <%- icon('user') %>
            <input id="email" name="email" type="email" value="<%= values.email %>" autocomplete="email" placeholder="name@example.com" required autofocus>
          </div>
        </div>

        <div class="field">
          <div class="field-row">
            <label for="password">Password</label>
            <a class="field-hint field-link" href="/forgot-password">Forgot password?</a>
          </div>
          <div class="password-field input-with-icon">
            <%- icon('lock') %>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
            <button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password">Show</button>
          </div>
        </div>

        <label class="check remember-check">
          <input type="checkbox" name="remember" <%= values.remember ? 'checked' : '' %>>
          <span>Keep me signed in for 30 days</span>
        </label>

        <button class="button button-primary button-lg button-block" type="submit">Log in<%- icon('arrow-right') %></button>
      </form>

      <p class="auth-switch">New to Checkpoint? <a class="text-link" href="/register<%= next ? `?next=${encodeURIComponent(next)}` : '' %>">Create an account</a></p>
    </section>

    <%- include('partials/auth-art') %>
  </div>
</main>

<%- include('partials/footer') %>
