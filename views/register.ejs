<%- include('partials/header') %>

<main id="main-content" class="auth-page">
  <div class="shell auth-grid">
    <section class="auth-panel">
      <p class="eyebrow">New account</p>
      <h1>Join Checkpoint</h1>
      <p class="muted">Create your profile and start keeping a record of the games you play.</p>

      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert">
          <strong>Please check the following:</strong>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="post" class="auth-form stack-form">
        <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
        <div class="field">
          <label for="name">Full name</label>
          <div class="input-with-icon">
            <%- icon('user') %>
            <input id="name" name="name" type="text" value="<%= values.name %>" autocomplete="name" minlength="2" maxlength="60" placeholder="Your full name" required autofocus>
          </div>
        </div>

        <div class="field">
          <label for="email">Email address</label>
          <div class="input-with-icon">
            <%- icon('message') %>
            <input id="email" name="email" type="email" value="<%= values.email %>" autocomplete="email" maxlength="<%= emailMaxLength %>" placeholder="name@example.com" required>
          </div>
        </div>

        <div class="auth-two">
          <div class="field">
            <div class="field-row">
              <label for="password">Password</label>
              <span class="field-hint">8+ characters</span>
            </div>
            <div class="password-field">
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="<%= passwordMaxBytes %>" placeholder="A letter and a number" required>
              <button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password">Show</button>
            </div>
          </div>

          <div class="field">
            <label for="confirmPassword">Confirm password</label>
            <div class="password-field">
              <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="<%= passwordMaxBytes %>" placeholder="Again, please" required>
              <button class="password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Show password confirmation">Show</button>
            </div>
          </div>
        </div>

        <button class="button button-primary button-lg button-block" type="submit">Create account<%- icon('arrow-right') %></button>
        <p class="form-agreement"><%- icon('lock', 'icon-sm') %>This prototype stores your account locally in its SQLite database. Passwords are hashed with bcrypt.</p>
      </form>

      <p class="auth-switch">Already have an account? <a class="text-link" href="/login<%= next ? `?next=${encodeURIComponent(next)}` : '' %>">Log in</a></p>
    </section>

    <%- include('partials/auth-art') %>
  </div>
</main>

<%- include('partials/footer') %>
