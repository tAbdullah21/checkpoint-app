<%- include('partials/header') %>

<main id="main-content" class="auth-main">
  <section class="auth-container auth-container-wide reveal">
    <div class="auth-page-heading">
      <span class="auth-mark">CP</span>
      <p class="content-label">NEW ACCOUNT</p>
      <h1>Join Checkpoint</h1>
      <p>Create your profile and start keeping a record of the games you play.</p>
    </div>

    <div class="auth-card">
      <% if (errors.length > 0) { %>
        <div class="form-errors" role="alert">
          <strong>Please check the following:</strong>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="post" class="auth-form">
        <div class="form-field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" value="<%= values.name %>" autocomplete="name" maxlength="60" placeholder="Your full name" required autofocus>
        </div>

        <div class="form-field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" value="<%= values.email %>" autocomplete="email" maxlength="254" placeholder="name@example.com" required>
        </div>

        <div class="form-field">
          <div class="field-label-row">
            <label for="password">Password</label>
            <span>At least 8 characters</span>
          </div>
          <div class="password-field">
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" placeholder="Include a letter and a number" required>
            <button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password">Show</button>
          </div>
        </div>

        <div class="form-field">
          <label for="confirmPassword">Confirm password</label>
          <div class="password-field">
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Enter the password again" required>
            <button class="password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Show password confirmation">Show</button>
          </div>
        </div>

        <button class="button button-primary button-full" type="submit">Create account</button>
        <p class="form-agreement">This prototype stores your account locally in its SQLite database.</p>
      </form>

      <div class="auth-switch">
        Already have an account? <a href="/login">Log in</a>
      </div>
    </div>

    <a class="back-home" href="/">← Back to the homepage</a>
  </section>
</main>

<%- include('partials/footer') %>
