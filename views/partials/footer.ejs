    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Checkpoint home">
            <img src="/images/checkpoint-mark.svg" alt="" width="30" height="30">
            <span>CHECKPOINT</span>
          </a>
          <p>The social game diary. Track what you play, get picks that match your taste, and share it with other players.</p>
          <ul class="footer-stack" aria-label="Built with">
            <li>Node.js 24</li>
            <li>Express 5</li>
            <li>SQLite</li>
            <li>EJS</li>
          </ul>
        </div>

        <nav class="footer-links" aria-label="Explore">
          <h2>Explore</h2>
          <a href="/games">Games</a>
          <a href="/reviews">Player reviews</a>
          <a href="/versus">Versus</a>
          <a href="/for-you">Picked for you</a>
          <a href="/lists">Player lists</a>
          <a href="/members">Members</a>
        </nav>

        <nav class="footer-links" aria-label="Your Checkpoint">
          <h2>Your Checkpoint</h2>
          <a href="/library">Library board</a>
          <a href="/tiers">Tier list</a>
          <a href="/profile">Profile</a>
          <a href="/wrapped">Wrapped</a>
          <a href="/activity">Activity</a>
        </nav>

        <div class="footer-links footer-project">
          <h2>Project</h2>
          <p>CSC 305 Software Engineering student project.</p>
          <% if (demoCommunity) { %><p>Demo community: sample profiles and their activity are fictional.</p><% } %>
          <p>Game artwork belongs to its respective publishers.</p>
        </div>
      </div>

      <div class="shell footer-bottom">
        <span>© <span id="current-year">2026</span> Checkpoint · CSC 305 student project</span>
        <span class="footer-shortcut">Press <kbd data-shortcut-key>⌘K</kbd> or <kbd>/</kbd> to search</span>
      </div>
    </footer>

    <%
      // The same is-active / aria-current pair as the header, for the mobile tab bar.
      const tabAttributes = (active, exact = active) => `class="tab${active ? ' is-active' : ''}"${active ? ` aria-current="${exact ? 'page' : 'true'}"` : ''}`;
      const isMe = currentUser && (currentPath.startsWith('/profile') || currentPath === '/account' || currentPath === `/members/${currentUser.id}`);
    %>
    <nav class="tabbar" aria-label="Quick navigation">
      <a <%- tabAttributes(currentPath === '/') %> href="/"><%- icon('home') %><span>Home</span></a>
      <a <%- tabAttributes(currentPath.startsWith('/games'), currentPath === '/games') %> href="/games"><%- icon('gamepad') %><span>Games</span></a>
      <% if (currentUser) { %>
        <a <%- tabAttributes(currentPath === '/for-you') %> href="/for-you"><%- icon('sparkles') %><span>For You</span></a>
        <a <%- tabAttributes(currentPath === '/library') %> href="/library"><%- icon('library') %><span>Library</span></a>
        <a <%- tabAttributes(isMe, currentPath === '/profile') %> href="/profile">
          <span class="avatar avatar-xs" style="--hue: <%= hueFor(currentUser.name) %>" aria-hidden="true"><%= initial(currentUser.name) %></span><span>Me</span>
        </a>
      <% } else { %>
        <a <%- tabAttributes(currentPath.startsWith('/members'), currentPath === '/members') %> href="/members"><%- icon('users') %><span>Members</span></a>
        <a <%- tabAttributes(currentPath.startsWith('/lists'), currentPath === '/lists') %> href="/lists"><%- icon('list') %><span>Lists</span></a>
        <a <%- tabAttributes(currentPath === '/login' || currentPath === '/register') %> href="/login<%= loginQuery %>"><%- icon('user') %><span>Log in</span></a>
      <% } %>
    </nav>


    <dialog class="palette" aria-label="Search Checkpoint" data-palette>
      <form class="palette-search" action="/games" method="get" role="search">
        <button class="palette-submit" type="submit" aria-label="Search all games"><%- icon('search', 'icon-lg') %></button>
        <label class="visually-hidden" for="palette-input">Search games or jump to a page</label>
        <input id="palette-input" name="query" type="text" inputmode="search" enterkeyhint="search" maxlength="80" placeholder="Search games, or jump to a page…"
          autocomplete="off" role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list" data-palette-input>
        <button class="palette-close" type="button" aria-label="Close search palette" data-palette-close><%- icon('x', 'icon icon-sm') %><span class="visually-hidden">Close search palette</span></button>
      </form>
      <div class="palette-results" id="palette-results" role="listbox" aria-label="Game results" data-palette-results></div>
      <div class="palette-pages" hidden data-palette-pages>
        <a href="/games" data-icon="gamepad">Browse all games</a>
        <a href="/versus" data-icon="bolt">Versus: two games head to head</a>
        <% if (currentUser) { %>
          <a href="/for-you" data-icon="sparkles">Picked for you</a>
          <a href="/library" data-icon="library">My library board</a>
          <a href="/tiers" data-icon="layers">My tier list</a>
          <a href="/profile" data-icon="user">My profile</a>
          <a href="/wrapped" data-icon="trophy">My Wrapped</a>
          <a href="/lists/new" data-icon="plus">Create a list</a>
          <a href="/notifications" data-icon="bell">Notifications</a>
          <a href="/profile/edit" data-icon="edit">Edit profile</a>
          <a href="/account" data-icon="shield">Account &amp; security</a>
        <% } else { %>
          <a href="/register<%= loginQuery %>" data-icon="user">Create an account</a>
          <a href="/login<%= loginQuery %>" data-icon="user">Log in</a>
        <% } %>
        <a href="/reviews" data-icon="message">Player reviews</a>
        <a href="/members" data-icon="users">Members</a>
        <a href="/lists" data-icon="list">Player lists</a>
        <a href="/activity" data-icon="activity">Community activity</a>
      </div>
      <div class="palette-footer" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
        <span><kbd>↵</kbd> to open</span>
        <span><kbd>Esc</kbd> to close</span>
      </div>
    </dialog>

    <script src="<%= assetUrl('/js/main.js') %>"></script>
  </body>
</html>
