<%
  const cardStatus = game.status ? statusMeta(game.status) : null;
  const cardMatch = typeof pickMatch === 'number'
    ? pickMatch
    : (typeof matches !== 'undefined' && matches && typeof matches.get === 'function' && !game.status ? matches.get(game.slug) : null);
  const showMatch = typeof pickMatch === 'number' || (cardMatch !== null && cardMatch !== undefined && cardMatch >= 60);
  const cardReturnTo = typeof returnTo === 'string' ? returnTo : '/';
%>
<article class="game-card">
  <div class="game-card-media">
    <% const preview = previewAttributes(game); %>
    <a class="game-card-poster<%= preview ? ' has-preview' : '' %>" href="/games/<%= game.slug %>" aria-label="View <%= game.title %>" data-poster-link <%- preview %>>
      <img <%- coverAttributes(game.image, '(max-width: 560px) 46vw, 240px') %> alt="<%= game.title %> cover" width="600" height="900" loading="<%= typeof eager !== 'undefined' && eager ? 'eager' : 'lazy' %>" decoding="async">
      <% if (preview) { %><span class="preview-badge" aria-hidden="true"><%- icon('play') %>Trailer</span><% } %>
    </a>
    <div class="game-card-top">
      <span class="rating-pill" title="Checkpoint rating"><%- icon('star') %><%= Number(game.rating).toFixed(1) %></span>
      <% if (showMatch) { %><span class="match-chip" title="How well this game fits your taste"><%= cardMatch %>% match</span><% } %>
    </div>
    <div class="game-card-bottom">
      <% if (cardStatus) { %>
        <span class="status-badge <%= cardStatus.className %>"><%= cardStatus.label %></span>
      <% } else if (!currentUser) { %>
        <a class="poster-add game-card-add" href="/login?next=<%= encodeURIComponent(cardReturnTo) %>" aria-label="Log in to add <%= game.title %> to your library" title="Log in to add this game"><%- icon('plus') %></a>
      <% } else { %>
        <form class="game-card-add" action="/library/<%= game.slug %>/add" method="post" data-quick-add>
          <input type="hidden" name="status" value="want_to_play">
          <input type="hidden" name="returnTo" value="<%= cardReturnTo %>">
          <button class="poster-add" type="submit" aria-label="Add <%= game.title %> to Want to Play" title="Add to Want to Play"><%- icon('plus') %></button>
        </form>
      <% } %>
    </div>
  </div>
  <div class="game-card-body">
    <h3><a href="/games/<%= game.slug %>"><%= game.title %></a></h3>
    <p><%= game.year %> · <%= game.genre %></p>
    <% if (typeof cardReason === 'string' && cardReason) { %><p class="game-card-reason"><%= cardReason %></p><% } %>
  </div>
</article>
