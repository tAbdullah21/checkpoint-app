<article class="game-card reveal" style="--delay: <%= (cardIndex || 0) * 45 %>ms">
  <div class="poster-frame">
    <a class="poster-link" href="/games/<%= game.slug %>" aria-label="View <%= game.title %>">
      <img src="<%= game.image %>" alt="<%= game.title %> cover" width="600" height="900" loading="lazy">
    </a>
    <% if (!currentUser) { %>
      <a class="poster-add" href="/login" aria-label="Log in to add <%= game.title %> to your library" title="Log in to add this game">+</a>
    <% } else if (game.status) { %>
      <a class="poster-library-status" href="/games/<%= game.slug %>" title="View game and manage status">
        <span aria-hidden="true">✓</span> <%= libraryStatusLabels[game.status] %>
      </a>
    <% } else { %>
      <form class="poster-action-form" action="/library/<%= game.slug %>/add" method="post">
        <input type="hidden" name="status" value="want_to_play">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <button class="poster-add" type="submit" aria-label="Add <%= game.title %> to Want to Play" title="Add to Want to Play">+</button>
      </form>
    <% } %>
  </div>
  <div class="game-card-topline">
    <h3><a href="/games/<%= game.slug %>"><%= game.title %></a></h3>
    <span><i>★</i> <%= Number(game.rating).toFixed(1) %></span>
  </div>
  <p><%= game.year %> · <%= game.genre %></p>
</article>
